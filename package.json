{
    "name": "medicare-connect",
    "version": "1.0.0",
    "description": "MediCare Connect: HealthCare Appointment Management System",
    "private": true,
    "workspaces": [
        "backend",
        "frontend",
        "admin-panel",
        "shared"
    ],
    "scripts": {
        "dev:backend": "cd backend && npm run dev",
        "dev:frontend": "cd frontend && npm run dev",
        "dev:admin": "cd admin-panel && npm run dev",
        "build:backend": "cd backend && npm run build",
        "build:frontend": "cd frontend && npm run build",
        "build:admin": "cd admin-panel && npm run build",
        "test": "cd backend && npm test",
        "test:coverage": "cd backend && npm run test:coverage",
        "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../admin-panel && npm install",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:build": "docker-compose build",
        "loc": "powershell -ExecutionPolicy Bypass -File scripts/count-loc.ps1",
        "seed": "cd backend && npm run seed"
    },
    "keywords": [
        "healthcare",
        "appointment",
        "management",
        "medical",
        "doctor",
        "patient"
    ],
    "author": "MediCare Connect Team",
    "license": "UNLICENSED"
}